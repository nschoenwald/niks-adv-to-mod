<section class="tab {{tab.cssClass}}" data-group="sheet" data-tab="links">
  {{#if scanned}}
  {{#if compendiums.length}}
  <fieldset class="natm-packin">
    <legend>{{localize "NATM.PackIn.Label"}}</legend>
    <p class="hint">{{localize "NATM.PackIn.Hint"}}</p>
    {{#if packLimited}}<p class="notification warning">{{packLimited}}</p>{{/if}}
    <ul class="natm-compendiums">
      {{#each compendiums as |pack|}}
      <li>
        <input type="checkbox" name="packIn.{{pack.collection}}" {{checked pack.checked}} {{disabled pack.disabled}}
               aria-label="{{localize "NATM.PackIn.Toggle"}}" data-tooltip="NATM.PackIn.Toggle">
        <span class="natm-pack-title">{{pack.title}}</span>
        <span class="natm-tag">{{pack.owner}}</span>
        <span class="natm-size">{{pack.linked}}</span>
        {{#if pack.note}}<span class="hint natm-pack-note">{{pack.note}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
  </fieldset>
  {{/if}}

  <fieldset>
    <legend>{{localize "NATM.Dependencies.Label"}}</legend>
    <p class="hint">{{localize "NATM.Dependencies.Hint"}}</p>
    {{#if dependencies.length}}
    {{#each dependencies as |dep|}}
    <div class="form-group">
      <label>{{dep.title}}{{#if dep.warning}} <i class="fa-solid fa-circle-exclamation" data-tooltip="{{dep.warning}}" aria-label="{{localize dep.warning}}"></i>{{/if}}</label>
      <div class="form-fields">
        <select name="level.{{dep.id}}">
          {{selectOptions @root.levelChoices selected=dep.level localize=true}}
        </select>
      </div>
      <p class="hint"><code>{{dep.id}}</code> · {{dep.reasons}}{{#if dep.allCopied}} · {{localize "NATM.Dependencies.AllCopied"}}{{/if}}</p>
    </div>
    {{/each}}
    {{else}}
    <p class="hint">{{localize "NATM.Dependencies.None"}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "NATM.Issues.Label"}}</legend>
    {{#unless issueGroups.length}}<p class="hint">{{localize "NATM.Issues.None"}}</p>{{/unless}}
    {{#each issueGroups as |group|}}
    <h4><i class="fa-solid fa-link-slash" inert></i> {{localize group.label}} ({{group.items.length}})</h4>
    <p class="hint">{{localize group.hint}}</p>
    <ul class="natm-issues">
      {{#each group.items as |item|}}
      <li>
        <code>{{item.uuid}}</code>{{#if item.name}} <strong>{{item.name}}</strong>{{/if}}
        <span class="hint">{{item.docs}}</span>
      </li>
      {{/each}}
    </ul>
    {{/each}}
  </fieldset>
  {{else}}
  <p class="natm-checking">{{#if busy}}<i class="fa-solid fa-spinner fa-spin" inert></i> {{/if}}<span class="natm-status-text">{{status}}</span></p>
  {{/if}}
</section>
